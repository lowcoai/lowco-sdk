{
  "name": "@lowcoai/auth",
  "version": "0.1.0",
  "description": "React provider and hooks for the lowco OAuth (Authorization Code + PKCE) flow.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lowcoai/lowco-sdk.git",
    "directory": "npm/auth"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --target es2020 --external react",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "auth",
    "oauth",
    "pkce",
    "lowco",
    "sdk",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  }
}
